# Backend API URL
# Dev: /api (Vite proxy forwards to localhost:3000)
# Production: set to deployed backend URL
VITE_API_URL=/api

# Telegram bot username (no @) used to build share / deep links.
VITE_BOT_USERNAME=OroPredictBot

# Backend for the dev proxy; defaults to http://localhost:3000
# API_PROXY_TARGET=http://localhost:3002
